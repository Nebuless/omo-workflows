{
  "name": "omo-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable OMO and Senpi customizations.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build extensions/better-custom/src/index.ts extensions/herdr/index.ts --outdir .build-check --target bun && rm -rf .build-check",
    "validate": "bun run validate:package && bun run typecheck && bun test",
    "validate:package": "bun scripts/validate-package.ts",
    "lint:commit": "commitlint --edit",
    "version:recommend": "conventional-recommended-bump -p conventionalcommits -v",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md",
    "configure:omo-preferences": "bun scripts/omo-preferences.ts",
    "repair:omo-comment-checker": "bun scripts/repair-omo-comment-checker.ts"
  },
  "dependencies": {
    "@code-yeongyu/senpi": "2026.9.10-2",
    "@earendil-works/pi-ai": "npm:@code-yeongyu/senpi-ai@2026.9.10-2",
    "@earendil-works/pi-tui": "npm:@code-yeongyu/senpi-tui@2026.9.10-2",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "conventional-recommended-bump": "12.1.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions/better-custom/src/index.ts",
      "./extensions/herdr/index.ts"
    ]
  }
}
