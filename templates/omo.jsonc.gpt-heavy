// GPT-heavy OMO task routing: Sol for general implementation; Astra for hardest reasoning.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/d7e224e478a4a77dba0d2104c336fdc72ad301e3/assets/omo.schema.json",
  "categories": {
    "memory-reflection": { "models": [{ "model": "9router/cx/gpt-6-luna", "reasoning": "low" }] },
    "visual-engineering": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "medium" }] },
    "ultrabrain": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
    "deep-low": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "medium" }] },
    "deep-high": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
    "architect": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
    "artistry": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "medium" }] },
    "quick": { "models": [{ "model": "9router/cx/gpt-6-luna", "reasoning": "low" }] },
    "unspecified-low": { "models": [{ "model": "9router/cx/gpt-6-luna", "reasoning": "low" }] },
    "unspecified-high": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "high" }] },
    "writing": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "medium" }] }
  },
  "[opencode]": {
    "agents": {
      "hephaestus": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "high" }] },
      "oracle": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
      "librarian": { "models": [{ "model": "9router/cx/gpt-6-luna", "reasoning": "low" }] },
      "explore": { "models": [{ "model": "9router/cx/gpt-6-luna", "reasoning": "low" }] },
      "multimodal-looker": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "medium" }] },
      "prometheus": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
      "metis": { "models": [{ "model": "9router/cx/gpt-6-astra", "reasoning": "high" }] },
      "momus": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "high" }] },
      "atlas": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "high" }] },
      "sisyphus-junior": { "models": [{ "model": "9router/cx/gpt-6.1-sol", "reasoning": "high" }] }
    }
  },
  "memory": {
    "reflection": { "category": "memory-reflection", "sandbox": "off" },
    "recall": { "category": "memory-reflection" }
  }
}
